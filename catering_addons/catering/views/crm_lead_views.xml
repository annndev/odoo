<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_catering" model="ir.ui.view">
        <field name="name">crm.lead.form.catering</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_catering_event" type="object" class="oe_stat_button" icon="fa-cutlery"
                        invisible="not job_id" string="Event"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Catering Event" name="catering_event" invisible="type == 'lead'">
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="event_date"/>
                            <field name="venue"/>
                        </group>
                        <group>
                            <field name="pax_estimated"/>
                            <field name="budget_per_pax"/>
                            <field name="job_id"/>
                        </group>
                    </group>
                    <field name="allergy_notes" placeholder="Allergies, vegetarian or halal guests..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
