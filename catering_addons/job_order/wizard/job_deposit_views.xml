<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="job_deposit_wizard_view_form" model="ir.ui.view">
        <field name="name">job.deposit.wizard.form</field>
        <field name="model">job.deposit.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Deposit">
                <p class="text-muted">The deposit is booked as an advance on the customer's receivable.
                    No revenue is recognised until the final invoice, which it is offset against.</p>
                <group>
                    <group>
                        <field name="job_id" readonly="1"/>
                        <field name="amount"/>
                        <field name="memo"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Register" class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
