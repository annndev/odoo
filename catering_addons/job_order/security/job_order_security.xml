<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="job_order_comp_rule" model="ir.rule">
        <field name="name">Job order: multi-company</field>
        <field name="model_id" ref="model_job_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="job_cost_line_comp_rule" model="ir.rule">
        <field name="name">Job cost line: multi-company</field>
        <field name="model_id" ref="model_job_cost_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
